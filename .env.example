# Copiá este archivo a .env.local y completá los valores.
#
# Ambas claves son PÚBLICAS por diseño: viajan en el bundle del cliente y
# cualquiera puede leerlas desde el navegador. Lo que protege los datos no es el
# secreto de la clave sino Row Level Security, que restringe cada fila a su
# dueño (ver supabase/schema.sql). Nunca pongas acá la service_role key: esa sí
# es secreta y saltea RLS por completo.
#
# Si estas variables faltan, la app arranca igual en modo invitado y guarda todo
# en localStorage.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
